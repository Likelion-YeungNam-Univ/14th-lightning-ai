# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.
DATABASE_URL=postgresql+psycopg://assit:assit@localhost:5432/assit

# 외부 데이터 API
DART_API_KEY=            # https://opendart.fss.or.kr (즉시 발급)
ECOS_API_KEY=            # https://ecos.bok.or.kr (즉시 발급)
FRED_API_KEY=            # https://fred.stlouisfed.org (즉시 발급)
YOUTUBE_API_KEY=         # Google Cloud Console → YouTube Data API v3
BRIEFING_API_KEY=        # 공공데이터포털 → 정책브리핑 정책뉴스 (자동승인)

# AI
ANTHROPIC_API_KEY=       # LLM (요약·라벨·문장·용어풀이)
OPENAI_API_KEY=          # 임베딩 (RAG, text-embedding-3-small)

# 앱
MOCK_LOGIN_ID=           # 모의 로그인 계정 (F-1.2)
MOCK_LOGIN_PW=
ADMIN_TOKEN=             # /admin/reset-demo 보호 토큰 (F-1.5)
